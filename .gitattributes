* text=auto
gradlew text eol=lf
*.sh text eol=lf
*.py text eol=lf
# the tools write JSON with LF on every OS; keep checkouts the same so regenerating never shows a diff
*.json text eol=lf
*.mcmeta text eol=lf
*.bat text eol=crlf
# tools/make_ramp.py writes the ramps with LF
*.gpl text eol=lf

# Binary game assets (small, kept in git)
*.png binary
*.ogg binary

# Layered art and audio sources (large): Git LFS. Run `git lfs install` once per machine.
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.ase filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.bbmodel filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
