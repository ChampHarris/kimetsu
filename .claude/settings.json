{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Kimetsu Lead",
  "effortLevel": "xhigh",
  "switchModelsOnFlag": false,
  "autoMemoryEnabled": false,
  "idleCompaction": false,
  "cleanupPeriodDays": 90,
  "statusLine": {
    "type": "command",
    "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/run.sh\" statusline.py",
    "padding": 0
  },
  "env": {
    "PYTHONUTF8": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4"
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew build*)",
      "Bash(./gradlew test*)",
      "Bash(./gradlew check*)",
      "Bash(./gradlew compileJava*)",
      "Bash(./gradlew :core*)",
      "Bash(./gradlew runGameTestServer*)",
      "Bash(./gradlew runData*)",
      "Bash(./gradlew tasks*)",
      "Bash(./gradlew dependencies*)",
      "Bash(./gradlew --version)",
      "Bash(python tools/check_spec.py*)",
      "Bash(python tools/texture_lint.py*)",
      "Bash(python tools/palette_fit.py*)",
      "Bash(python tools/vanilla_coverage.py*)",
      "Bash(python tools/audio_lint.py*)",
      "Bash(python tools/contact_sheet.py*)",
      "Bash(python tools/clip_to_frames.py*)",
      "Bash(python tools/refsrc.py*)",
      "Bash(python tools/sims/pulse_sim.py*)",
      "Bash(python tools/sims/duel_sim.py*)",
      "Bash(python .claude/hooks/tests/test_guard.py*)",
      "Bash(python .claude/hooks/tests/test_effort.py*)",
      "Bash(python .claude/hooks/tests/test_spec_approval.py*)",
      "Bash(python .claude/hooks/tests/test_comms.py*)",
      "Bash(python .claude/hooks/tests/test_quality.py*)",
      "Bash(python tools/kit_lint.py*)",
      "Bash(python tools/session_mine.py*)",
      "Bash(python tools/tests/test_kit_lint.py*)",
      "Bash(python tools/vanilla_scope.py*)",
      "Bash(python tools/vanilla_style.py*)",
      "Bash(python tools/make_ramp.py*)",
      "Bash(python tools/townsfolk_names.py*)",
      "Bash(python tools/sims/night_sim.py*)",
      "Bash(python tools/tests/test_vanilla_scope.py*)",
      "Bash(python3 tools/check_spec.py*)",
      "Bash(python3 tools/texture_lint.py*)",
      "Bash(python3 tools/palette_fit.py*)",
      "Bash(python3 tools/vanilla_coverage.py*)",
      "Bash(python3 tools/audio_lint.py*)",
      "Bash(python3 tools/contact_sheet.py*)",
      "Bash(python3 tools/clip_to_frames.py*)",
      "Bash(python3 tools/refsrc.py*)",
      "Bash(python3 tools/sims/pulse_sim.py*)",
      "Bash(python3 tools/sims/duel_sim.py*)",
      "Bash(python3 .claude/hooks/tests/test_guard.py*)",
      "Bash(python3 .claude/hooks/tests/test_effort.py*)",
      "Bash(python3 .claude/hooks/tests/test_spec_approval.py*)",
      "Bash(python3 .claude/hooks/tests/test_comms.py*)",
      "Bash(python3 .claude/hooks/tests/test_quality.py*)",
      "Bash(python3 tools/kit_lint.py*)",
      "Bash(python3 tools/session_mine.py*)",
      "Bash(python3 tools/tests/test_kit_lint.py*)",
      "Bash(python3 tools/vanilla_scope.py*)",
      "Bash(python3 tools/vanilla_style.py*)",
      "Bash(python3 tools/make_ramp.py*)",
      "Bash(python3 tools/townsfolk_names.py*)",
      "Bash(python3 tools/sims/night_sim.py*)",
      "Bash(python3 tools/tests/test_vanilla_scope.py*)",
      "Bash(py -3 tools/check_spec.py*)",
      "Bash(py -3 tools/texture_lint.py*)",
      "Bash(py -3 tools/palette_fit.py*)",
      "Bash(py -3 tools/vanilla_coverage.py*)",
      "Bash(py -3 tools/audio_lint.py*)",
      "Bash(py -3 tools/contact_sheet.py*)",
      "Bash(py -3 tools/clip_to_frames.py*)",
      "Bash(py -3 tools/refsrc.py*)",
      "Bash(py -3 tools/sims/pulse_sim.py*)",
      "Bash(py -3 tools/sims/duel_sim.py*)",
      "Bash(py -3 .claude/hooks/tests/test_guard.py*)",
      "Bash(py -3 .claude/hooks/tests/test_effort.py*)",
      "Bash(py -3 .claude/hooks/tests/test_spec_approval.py*)",
      "Bash(py -3 .claude/hooks/tests/test_comms.py*)",
      "Bash(py -3 .claude/hooks/tests/test_quality.py*)",
      "Bash(py -3 tools/kit_lint.py*)",
      "Bash(py -3 tools/session_mine.py*)",
      "Bash(py -3 tools/tests/test_kit_lint.py*)",
      "Bash(py -3 tools/vanilla_scope.py*)",
      "Bash(py -3 tools/vanilla_style.py*)",
      "Bash(py -3 tools/make_ramp.py*)",
      "Bash(py -3 tools/townsfolk_names.py*)",
      "Bash(py -3 tools/sims/night_sim.py*)",
      "Bash(py -3 tools/tests/test_vanilla_scope.py*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git stash*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(ffprobe *)",
      "WebSearch",
      "WebFetch(domain:docs.neoforged.net)",
      "WebFetch(domain:neoforged.net)",
      "WebFetch(domain:maven.neoforged.net)",
      "WebFetch(domain:minecraft.wiki)",
      "WebFetch(domain:www.minecraft.net)",
      "WebFetch(domain:kimetsu-no-yaiba.fandom.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:modrinth.com)",
      "WebFetch(domain:www.curseforge.com)",
      "WebFetch(domain:docs.zigythebird.com)",
      "WebFetch(domain:wiki.geckolib.com)",
      "WebFetch(domain:moddedmc.wiki)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:api.modrinth.com)",
      "WebFetch(domain:www.jetbrains.com)",
      "WebFetch(domain:renderdoc.org)",
      "mcp__mctest__mc_status",
      "mcp__mctest__mc_screenshot",
      "mcp__mctest__mc_logs",
      "mcp__mctest__mc_crash_report",
      "mcp__mctest__mc_player",
      "mcp__mctest__mc_entities",
      "mcp__mctest__mc_block",
      "mcp__mctest__mc_time_status",
      "mcp__mctest__mc_gametest_list",
      "mcp__mctest__mc_server_status",
      "mcp__mctest__mc_server_logs",
      "mcp__mctest__mc_server_players"
    ],
    "ask": [
      "Bash(git rebase*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git branch --delete*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --prune*)",
      "Bash(git push * --prune*)",
      "Bash(git push * :*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" session_start.py",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" doctrine_inject.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" effort_prompt.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" guard_paths.py",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^mcp__(idea|jetbrains|intellij|ide)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" guard_paths.py",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*gradle*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" test_watch.py",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(*gradle*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" test_watch.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" effort_prompt.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" spec_approval.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" post_edit.py",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*gradle*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" test_watch.py",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(*gradle*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" test_watch.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" effort_prompt.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" spec_approval.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*gradle*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" test_watch.py",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(*gradle*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" test_watch.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" spec_gate.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" spec_approval.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" quality_gate.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" commit_nudge.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "jdtls-lsp@claude-plugins-official": true,
    "savvy-progress@kimetsu-pinned": true
  },
  "extraKnownMarketplaces": {
    "kimetsu-pinned": {
      "source": {
        "source": "settings",
        "name": "kimetsu-pinned",
        "plugins": [
          {
            "name": "savvy-progress",
            "description": "Savvy Progress mod (JohnnyVizz/claude-kit) pinned to commit c871c153 (v1.2.1). To update: review the new commit, then change sha and version here (docs/tools/kit-watch.md).",
            "version": "1.2.1",
            "source": {
              "source": "git-subdir",
              "url": "https://github.com/JohnnyVizz/claude-kit.git",
              "path": "plugins/savvy-progress",
              "ref": "main",
              "sha": "c871c153ead54ad9547cc717d0f3e5a676c73986"
            }
          }
        ]
      }
    }
  }
}
